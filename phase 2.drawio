        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle Campus Event &amp; Student Club Hub - Conceptual Class Diagram\n\nskinparam classAttributeIconSize 0\n\nclass User {\n  UserID\n  FullName\n  Email\n  Password\n  Role\n}\n\nclass Student {\n  Major\n}\n\nclass ClubManager {\n  ManagerID\n}\n\nclass Admin {\n  AdminID\n}\n\nclass Club {\n  ClubID\n  Name\n  Description\n  Logo\n}\n\nclass Event {\n  EventID\n  Title\n  Date\n  Time\n  Location\n  Capacity\n  ApprovalStatus\n}\n\nclass Registration {\n  RegistrationID\n  RegistrationDate\n  AttendanceStatus\n}\n\nclass Ticket {\n  TicketID\n  QRCode\n}\n\nclass Budget {\n  BudgetID\n  AllocatedAmount\n  RemainingAmount\n}\n\nclass Expense {\n  ExpenseID\n  Amount\n  Date\n  Description\n}\n\nclass Feedback {\n  FeedbackID\n  Rating\n  Comment\n}\n\nUser &lt;|-- Student\nUser &lt;|-- ClubManager\nUser &lt;|-- Admin\n\nClubManager \&quot;1\&quot; -- \&quot;0..*\&quot; Club : manages\nClub \&quot;1\&quot; -- \&quot;0..*\&quot; Event : organizes\n\nStudent \&quot;1\&quot; -- \&quot;0..*\&quot; Registration : creates\nEvent \&quot;1\&quot; -- \&quot;0..*\&quot; Registration : has\nRegistration \&quot;1\&quot; -- \&quot;0..1\&quot; Ticket : generates\n\nClub \&quot;1\&quot; -- \&quot;1\&quot; Budget : has\nClub \&quot;1\&quot; -- \&quot;0..*\&quot; Expense : records\n\nStudent \&quot;1\&quot; -- \&quot;0..*\&quot; Feedback : writes\nEvent \&quot;1\&quot; -- \&quot;0..*\&quot; Feedback : receives\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ELGNXzhX3PAjJXNmmNOv-1">
