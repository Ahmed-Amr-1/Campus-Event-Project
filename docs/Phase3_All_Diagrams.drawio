r=#111827;fontSize=14;labelBackgroundColor=#FFFFFF;html=1;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="940" as="sourcePoint" /><mxPoint x="135" y="940" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg11" value="11. Return login error" style="dashed=1;fixDash=1;dashPattern=5 4;endArrow=block;endSize=9;strokeWidth=1.5;strokeColor=#334155;fontColor=#111827;fontSize=14;labelBackgroundColor=#FFFFFF;html=1;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="1070" as="sourcePoint" /><mxPoint x="385" y="1070" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg12" value="12. Display error message" style="dashed=1;fixDash=1;dashPattern=5 4;endArrow=block;endSize=9;strokeWidth=1.5;strokeColor=#334155;fontColor=#111827;fontSize=14;labelBackgroundColor=#FFFFFF;html=1;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="1150" as="sourcePoint" /><mxPoint x="135" y="1150" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step8" value="8. Create authenticated session" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F59E0B;fillColor=#FEF3C7;fontColor=#172033;fontSize=15;" vertex="1" parent="1"><mxGeometry x="660" y="760" width="298" height="48" as="geometry" /></mxCell><mxCell id="hash_note" value="If user exists, verify password using the stored hash." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#FACC15;fillColor=#FEF9C3;fontColor=#172033;fontSize=14;" vertex="1" parent="1"><mxGeometry x="765" y="595" width="343" height="42" as="geometry" /></mxCell><mxCell id="title" value="Sequence Diagram 01 - User Login" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="44" y="1265" width="560" height="32" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="02_Event_Registration" id="52c44226f7d04606">
    <mxGraphModel dx="1860" dy="1910" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;\nsequenceDiagram\n    autonumber\n\n    actor S as Student\n    participant V as Event Page (View)\n    participant C as RegistrationController\n    participant RM as RegistrationModel\n    participant TM as TicketModel\n    participant DB as Database\n\n    S-&gt;&gt;V: Select Event and click Register\n    V-&gt;&gt;C: registerForEvent(studentId, eventId)\n    activate C\n\n    C-&gt;&gt;RM: validateAndRegister(studentId, eventId)\n    activate RM\n\n    RM-&gt;&gt;DB: Check event status, seats, and registration\n    activate DB\n    DB--&gt;&gt;RM: Event and registration data\n    deactivate DB\n\n    alt Event approved, seat available, student not registered\n        RM-&gt;&gt;DB: Save registration and reserve seat atomically\n        activate DB\n        DB--&gt;&gt;RM: registrationId\n        deactivate DB\n\n        RM-&gt;&gt;TM: createDigitalTicket(registrationId)\n        activate TM\n        TM-&gt;&gt;DB: Save unique QR ticket\n        activate DB\n        DB--&gt;&gt;TM: Ticket saved\n        deactivate DB\n        TM--&gt;&gt;RM: QR ticket\n        deactivate TM\n\n        RM--&gt;&gt;C: Registration confirmed + ticket\n        C--&gt;&gt;V: Show confirmation and QR ticket\n        V--&gt;&gt;S: Display successful registration\n\n    else Event is full\n        RM--&gt;&gt;C: Registration failed - no seats\n        C--&gt;&gt;V: Show event full message\n        V--&gt;&gt;S: Display registration error\n\n    else Student already registered\n        RM--&gt;&gt;C: Registration failed - duplicate\n        C--&gt;&gt;V: Show already registered message\n        V--&gt;&gt;S: Display registration error\n\n    else Event unavailable or not approved\n        RM--&gt;&gt;C: Registration failed - unavailable\n        C--&gt;&gt;V: Show event unavailable message\n        V--&gt;&gt;S: Display registration error\n    end\n\n    deactivate RM\n    deactivate C\n&quot;,&#10;  &quot;config&quot;: null,&#10;  &quot;version&quot;: &quot;12&quot;&#10;}" id="rdvFLVuVqnViDXpQw77S-72">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
