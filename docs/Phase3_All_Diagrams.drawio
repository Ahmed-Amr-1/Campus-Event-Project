<diagram name="MVC_Classes_Recovered" id="eaf1fe6188a2462e">
    <mxGraphModel dx="1788" dy="2138" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;\nclassDiagram\ndirection LR\n\nclass LoginPage {\n    &lt;&lt;View&gt;&gt;\n    +showLoginForm()\n    +displayLoginResult()\n}\n\nclass EventPage {\n    &lt;&lt;View&gt;&gt;\n    +showEventDetails()\n    +displayRegistrationResult()\n}\n\nclass ScannerPage {\n    &lt;&lt;View&gt;&gt;\n    +scanQR()\n    +displayAttendanceResult()\n}\n\nclass EventForm {\n    &lt;&lt;View&gt;&gt;\n    +showEventForm()\n    +displayCreationResult()\n}\n\nclass AdminReviewPage {\n    &lt;&lt;View&gt;&gt;\n    +showPendingEvents()\n    +displayReviewResult()\n}\n\nclass FinanceDashboard {\n    &lt;&lt;View&gt;&gt;\n    +showBudget()\n    +showExpenseResult()\n}\n\nclass StudentPortal {\n    &lt;&lt;View&gt;&gt;\n    +showClubs()\n    +showNotifications()\n}\n\nclass AuthController {\n    &lt;&lt;Controller&gt;&gt;\n    +submitLogin(email, password)\n    +createSession(userId)\n}\n\nclass RegistrationController {\n    &lt;&lt;Controller&gt;&gt;\n    +registerForEvent(studentId, eventId)\n}\n\nclass AttendanceController {\n    &lt;&lt;Controller&gt;&gt;\n    +verifyCheckIn(qrToken, eventId)\n}\n\nclass EventController {\n    &lt;&lt;Controller&gt;&gt;\n    +createEvent(eventData)\n}\n\nclass ApprovalController {\n    &lt;&lt;Controller&gt;&gt;\n    +getPendingEvents()\n    +reviewEvent(eventId, decision)\n}\n\nclass FinanceController {\n    &lt;&lt;Controller&gt;&gt;\n    +allocateBudget(clubId, amount)\n    +recordExpense(clubId, amount, description)\n}\n\nclass StudentController {\n    &lt;&lt;Controller&gt;&gt;\n    +subscribeToClub(clubId)\n    +getMyNotifications()\n}\n\nclass UserModel {\n    &lt;&lt;Model&gt;&gt;\n    +authenticate(email, password)\n}\n\nclass RegistrationModel {\n    &lt;&lt;Model&gt;&gt;\n    +validateAndRegister(studentId, eventId)\n    +markAttendance(registrationId)\n}\n\nclass TicketModel {\n    &lt;&lt;Model&gt;&gt;\n    +createDigitalTicket(registrationId)\n    +validateTicket(qrToken, eventId, managerId)\n}\n\nclass EventModel {\n    &lt;&lt;Model&gt;&gt;\n    +validateEventDetails(eventData)\n    +createPendingEvent(managerId, eventData)\n    +fetchPendingEvents()\n    +updateApprovalStatus(eventId, decision)\n}\n\nclass BudgetModel {\n    &lt;&lt;Model&gt;&gt;\n    +allocateBudget(clubId, amount)\n}\n\nclass ExpenseModel {\n    &lt;&lt;Model&gt;&gt;\n    +validateAndRecordExpense(clubId, amount, description)\n}\n\nclass SubscriptionModel {\n    &lt;&lt;Model&gt;&gt;\n    +subscribe(studentId, clubId)\n}\n\nclass NotificationModel {\n    &lt;&lt;Model&gt;&gt;\n    +notifyClubSubscribers(clubId, eventId)\n    +fetchNotifications(studentId)\n}\n\nLoginPage ..&gt; AuthController : submits\nAuthController ..&gt; UserModel : authenticates\n\nEventPage ..&gt; RegistrationController : registers\nRegistrationController ..&gt; RegistrationModel : validates\nRegistrationModel ..&gt; TicketModel : generates ticket\n\nScannerPage ..&gt; AttendanceController : scans\nAttendanceController ..&gt; TicketModel : validates ticket\nAttendanceController ..&gt; RegistrationModel : marks attendance\n\nEventForm ..&gt; EventController : creates\nEventController ..&gt; EventModel : manages event\n\nAdminReviewPage ..&gt; ApprovalController : reviews\nApprovalController ..&gt; EventModel : approves or rejects\nApprovalController ..&gt; NotificationModel : triggers notifications\n\nFinanceDashboard ..&gt; FinanceController : submits\nFinanceController ..&gt; BudgetModel : allocates\nFinanceController ..&gt; ExpenseModel : records\n\nStudentPortal ..&gt; StudentController : requests\nStudentController ..&gt; SubscriptionModel : subscribes\nStudentController ..&gt; NotificationModel : gets notifications\n\n&quot;,&#10;  &quot;config&quot;: null,&#10;  &quot;version&quot;: &quot;12&quot;&#10;}" id="INjNVVMCv36Y6EAWg6hC-237">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;LoginPage&lt;/b&gt;" mermaidId="n:LoginPage" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=66;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=#FDF4FF;whiteSpace=wrap;spacingTop=24;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;fontFamily=Recursive;strokeWidth=2;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;LoginPage&lt;/b&gt;" id="INjNVVMCv36Y6EAWg6hC-238">
