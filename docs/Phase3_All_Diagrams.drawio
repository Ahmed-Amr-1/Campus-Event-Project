        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&quot;data&quot;: &quot;\nclassDiagram\ndirection LR\n\nclass User {\n    -int userId\n    -string fullName\n    -string email\n    -string passwordHash\n    +updateProfile()\n}\n\nclass Student {\n    -string studentNumber\n    -string major\n}\n\nclass ClubManager {\n    +viewManagedClubs()\n}\n\nclass Admin {\n    +viewAdminDashboard()\n}\n\nclass Club {\n    -int clubId\n    -string name\n    -string description\n    -string logoUrl\n}\n\nclass Event {\n    -int eventId\n    -string title\n    -datetime startDate\n    -string location\n    -int capacity\n    -string status\n    -bool hasAvailableSeats()\n}\n\nclass Registration {\n    -int registrationId\n    -string status\n    -datetime registeredAt\n    +markAttended()\n}\n\nclass Ticket {\n    -int ticketId\n    -string qrToken\n    -bool isUsed\n    -bool isValid()\n}\n\nclass Budget {\n    -int budgetId\n    -decimal allocatedAmount\n    -decimal remainingAmount\n    -bool canCover(amount)\n}\n\nclass Expense {\n    -int expenseId\n    -decimal amount\n    -string description\n    -datetime expenseDate\n}\n\nclass Feedback {\n    -int feedbackId\n    -int rating\n    -string comment\n}\n\nclass Subscription {\n    -int subscriptionId\n    -datetime subscribedAt\n}\n\nclass Notification {\n    -int notificationId\n    -string message\n    -bool isRead\n    +markAsRead()\n}\n\nUser &lt;|-- Student\nUser &lt;|-- ClubManager\nUser &lt;|-- Admin\n\nClubManager \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Club : manages\nClub \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Event : organizes\n\nStudent \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Registration : makes\nEvent \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Registration : receives\nRegistration \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Ticket : generates\n\nClub \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Budget : has\nBudget \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Expense : records\n\nStudent \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Feedback : writes\nEvent \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Feedback : receives\n\nStudent \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Subscription : creates\nClub \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Subscription : receives\n\nStudent \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Notification : receives\n&quot;, &quot;config&quot;: null, &quot;version&quot;: &quot;12&quot;}" id="INjNVVMCv36Y6EAWg6hC-1">
