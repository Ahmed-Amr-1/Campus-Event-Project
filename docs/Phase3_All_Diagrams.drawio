<diagram name="Final_Detailed_Class_Diagram_Aligned" id="ffdf79f1963045da">
    <mxGraphModel dx="1788" dy="2138" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&quot;data&quot;: &quot;\nclassDiagram\ndirection LR\n\n%% DOMAIN CLASSES\n\nclass User {\n    -int userId\n    -string fullName\n    -string email\n    -string passwordHash\n    +updateProfile() void\n}\n\nclass Student {\n    -string studentNumber\n    -string major\n}\n\nclass ClubManager {\n    +viewManagedClubs() void\n}\n\nclass Admin {\n    +viewAdminDashboard() void\n}\n\nclass Club {\n    -int clubId\n    -string name\n    -string description\n    -string logoUrl\n}\n\nclass Event {\n    -int eventId\n    -string title\n    -datetime startDate\n    -string location\n    -int capacity\n    -string status\n    +hasAvailableSeats() bool\n}\n\nclass Registration {\n    -int registrationId\n    -string status\n    -datetime registeredAt\n    +markAttended() void\n}\n\nclass Ticket {\n    -int ticketId\n    -string qrToken\n    -bool isUsed\n    +isValid() bool\n}\n\nclass Budget {\n    -int budgetId\n    -decimal allocatedAmount\n    -decimal remainingAmount\n    +canCover(amount: decimal) bool\n}\n\nclass Expense {\n    -int expenseId\n    -decimal amount\n    -string description\n    -datetime expenseDate\n}\n\nclass Feedback {\n    -int feedbackId\n    -int rating\n    -string comment\n}\n\nclass Subscription {\n    -int subscriptionId\n    -datetime subscribedAt\n}\n\nclass Notification {\n    -int notificationId\n    -string message\n    -bool isRead\n    +markAsRead() void\n}\n\n%% INHERITANCE\n\nUser &lt;|-- Student\nUser &lt;|-- ClubManager\nUser &lt;|-- Admin\n\n%% DOMAIN ASSOCIATIONS\n\nClubManager \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Club : manages\nClub \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Event : organizes\n\nStudent \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Registration : makes\nEvent \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Registration : receives\nRegistration \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Ticket : generates\n\nClub \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Budget : has\nBudget \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Expense : records\n\nStudent \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Feedback : writes\nEvent \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Feedback : receives\n\nStudent \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Subscription : creates\nClub \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Subscription : receives\n\nStudent \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Notification : receives\n\n\n%% VIEW CLASSES\n\nclass LoginPage {\n    &lt;&lt;View&gt;&gt;\n    +showLoginForm() void\n    +displayLoginResult() void\n}\n\nclass EventPage {\n    &lt;&lt;View&gt;&gt;\n    +showEventDetails() void\n    +displayRegistrationResult() void\n}\n\nclass ScannerPage {\n    &lt;&lt;View&gt;&gt;\n    +scanQR() void\n    +displayAttendanceResult() void\n}\n\nclass EventForm {\n    &lt;&lt;View&gt;&gt;\n    +showEventForm() void\n    +displayCreationResult() void\n}\n\nclass AdminReviewPage {\n    &lt;&lt;View&gt;&gt;\n    +showPendingEvents() void\n    +displayReviewResult() void\n}\n\nclass FinanceDashboard {\n    &lt;&lt;View&gt;&gt;\n    +showBudget() void\n    +showExpenseResult() void\n}\n\nclass StudentPortal {\n    &lt;&lt;View&gt;&gt;\n    +showClubs() void\n    +showNotifications() void\n}\n\n\n%% CONTROLLER CLASSES\n\nclass AuthController {\n    &lt;&lt;Controller&gt;&gt;\n    +submitLogin(email: string, password: string) bool\n    +createSession(userId: int) void\n}\n\nclass RegistrationController {\n    &lt;&lt;Controller&gt;&gt;\n    +registerForEvent(studentId: int, eventId: int) bool\n}\n\nclass AttendanceController {\n    &lt;&lt;Controller&gt;&gt;\n    +verifyCheckIn(qrToken: string, eventId: int) bool\n}\n\nclass EventController {\n    &lt;&lt;Controller&gt;&gt;\n    +createEvent(eventData: Event) bool\n}\n\nclass ApprovalController {\n    &lt;&lt;Controller&gt;&gt;\n    +getPendingEvents() List\n    +reviewEvent(eventId: int, decision: string) bool\n}\n\nclass FinanceController {\n    &lt;&lt;Controller&gt;&gt;\n    +allocateBudget(clubId: int, amount: decimal) bool\n    +recordExpense(clubId: int, amount: decimal, description: string) bool\n}\n\nclass StudentController {\n    &lt;&lt;Controller&gt;&gt;\n    +subscribeToClub(clubId: int) bool\n    +getMyNotifications() List\n}\n\n\n%% MODEL SERVICE CLASSES\n\nclass UserModel {\n    &lt;&lt;Model&gt;&gt;\n    +authenticate(email: string, password: string) bool\n}\n\nclass RegistrationModel {\n    &lt;&lt;Model&gt;&gt;\n    +validateAndRegister(studentId: int, eventId: int) bool\n    +markAttendance(registrationId: int) bool\n}\n\nclass TicketModel {\n    &lt;&lt;Model&gt;&gt;\n    +createDigitalTicket(registrationId: int) Ticket\n    +validateTicket(qrToken: string, eventId: int, managerId: int) bool\n}\n\nclass EventModel {\n    &lt;&lt;Model&gt;&gt;\n    +validateEventDetails(eventData: Event) bool\n    +createPendingEvent(managerId: int, eventData: Event) Event\n    +fetchPendingEvents() List\n    +updateApprovalStatus(eventId: int, decision: string) bool\n}\n\nclass BudgetModel {\n    &lt;&lt;Model&gt;&gt;\n    +allocateBudget(clubId: int, amount: decimal) bool\n}\n\nclass ExpenseModel {\n    &lt;&lt;Model&gt;&gt;\n    +validateAndRecordExpense(clubId: int, amount: decimal, description: string) bool\n}\n\nclass SubscriptionModel {\n    &lt;&lt;Model&gt;&gt;\n    +subscribe(studentId: int, clubId: int) bool\n}\n\nclass NotificationModel {\n    &lt;&lt;Model&gt;&gt;\n    +notifyClubSubscribers(clubId: int, eventId: int) void\n    +fetchNotifications(studentId: int) List\n}\n\n\n%% VIEW TO CONTROLLER DEPENDENCIES\n\nLoginPage ..&gt; AuthController : submits\nEventPage ..&gt; RegistrationController : registers\nScannerPage ..&gt; AttendanceController : scans\nEventForm ..&gt; EventController : creates\nAdminReviewPage ..&gt; ApprovalController : reviews\nFinanceDashboard ..&gt; FinanceController : submits\nStudentPortal ..&gt; StudentController : requests\n\n\n%% CONTROLLER TO MODEL DEPENDENCIES\n\nAuthController ..&gt; UserModel : authenticates\n\nRegistrationController ..&gt; RegistrationModel : registers\n\nAttendanceController ..&gt; TicketModel : validates\nAttendanceController ..&gt; RegistrationModel : records attendance\n\nEventController ..&gt; EventModel : creates\n\nApprovalController ..&gt; EventModel : reviews\nApprovalController ..&gt; NotificationModel : notifies\n\nFinanceController ..&gt; BudgetModel : allocates\nFinanceController ..&gt; ExpenseModel : records\n\nStudentController ..&gt; SubscriptionModel : subscribes\nStudentController ..&gt; NotificationModel : reads\n\n\n%% MODEL TO DOMAIN DEPENDENCIES\n\nUserModel ..&gt; User : accesses\nRegistrationModel ..&gt; Registration : manages\nRegistrationModel ..&gt; Event : checks capacity\nTicketModel ..&gt; Ticket : creates and validates\nEventModel ..&gt; Event : manages\nBudgetModel ..&gt; Budget : manages\nExpenseModel ..&gt; Expense : records\nSubscriptionModel ..&gt; Subscription : manages\nNotificationModel ..&gt; Notification : manages\n&quot;, &quot;config&quot;: null, &quot;version&quot;: &quot;12&quot;}" id="INjNVVMCv36Y6EAWg6hC-362">
