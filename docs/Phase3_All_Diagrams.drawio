<diagram name="03_QR_Attendance_Corrected" id="f9d5ed77e8414feb">
    <mxGraphModel dx="568" dy="764" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&quot;data&quot;: &quot;\nsequenceDiagram\n    autonumber\n\n    actor CM as Club Manager\n    participant V as Scanner Page (View)\n    participant C as AttendanceController\n    participant TM as TicketModel\n    participant RM as RegistrationModel\n    participant DB as Database\n\n    CM-&gt;&gt;V: Scan student's QR ticket\n    V-&gt;&gt;C: verifyCheckIn(qrToken, eventId)\n    activate C\n\n    C-&gt;&gt;TM: validateTicket(qrToken, eventId, managerId)\n    activate TM\n\n    TM-&gt;&gt;DB: Fetch ticket, event and manager access data\n    activate DB\n    DB--&gt;&gt;TM: Ticket data / Invalid / Unauthorized\n    deactivate DB\n\n    TM--&gt;&gt;C: Ticket validation result\n    deactivate TM\n\n    alt Valid ticket and authorized manager\n\n        C-&gt;&gt;RM: markAttendance(registrationId)\n        activate RM\n\n        RM-&gt;&gt;DB: Atomically mark registration as Attended\n        activate DB\n        DB--&gt;&gt;RM: Updated / Already attended / Not eligible\n        deactivate DB\n\n        alt Attendance updated successfully\n            RM--&gt;&gt;C: Attendance confirmed\n            C--&gt;&gt;V: Return success message\n            V--&gt;&gt;CM: Display Attendance Recorded\n\n        else Student already checked in\n            RM--&gt;&gt;C: Duplicate check-in\n            C--&gt;&gt;V: Return already attended error\n            V--&gt;&gt;CM: Display Already Checked In\n\n        else Registration not eligible\n            RM--&gt;&gt;C: Attendance rejected\n            C--&gt;&gt;V: Return registration error\n            V--&gt;&gt;CM: Display Invalid Registration\n        end\n\n        deactivate RM\n\n    else Invalid QR or wrong event\n        C--&gt;&gt;V: Return invalid ticket error\n        V--&gt;&gt;CM: Display Invalid QR Ticket\n\n    else Manager not authorized\n        C--&gt;&gt;V: Return access denied\n        V--&gt;&gt;CM: Display Access Denied\n    end\n\n    deactivate C\n&quot;, &quot;config&quot;: null, &quot;version&quot;: &quot;12&quot;}" id="oW-CiLCDWRrnG51zjrZo-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
