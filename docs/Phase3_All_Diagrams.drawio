        <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;\nerDiagram\n\n    USERS {\n        int user_id PK\n        string full_name\n        string email UK\n        string password_hash\n        string role\n        string student_number\n        string major\n    }\n\n    CLUBS {\n        int club_id PK\n        string name\n        string description\n        string logo_url\n        int manager_id FK\n    }\n\n    EVENTS {\n        int event_id PK\n        int club_id FK\n        int created_by FK\n        int reviewed_by FK\n        string title\n        string description\n        datetime start_date\n        string location\n        int capacity\n        string status\n    }\n\n    REGISTRATIONS {\n        int registration_id PK\n        int student_id FK\n        int event_id FK\n        datetime registered_at\n        string status\n        boolean attended\n    }\n\n    TICKETS {\n        int ticket_id PK\n        int registration_id FK,UK\n        string qr_token UK\n        boolean is_used\n        datetime issued_at\n    }\n\n    BUDGETS {\n        int budget_id PK\n        int club_id FK,UK\n        decimal allocated_amount\n        decimal remaining_amount\n    }\n\n    EXPENSES {\n        int expense_id PK\n        int budget_id FK\n        int recorded_by FK\n        decimal amount\n        string description\n        datetime expense_date\n    }\n\n    FEEDBACK {\n        int feedback_id PK\n        int student_id FK\n        int event_id FK\n        int rating\n        string comment\n    }\n\n    SUBSCRIPTIONS {\n        int subscription_id PK\n        int student_id FK\n        int club_id FK\n        datetime subscribed_at\n    }\n\n    NOTIFICATIONS {\n        int notification_id PK\n        int user_id FK\n        int event_id FK\n        string message\n        boolean is_read\n        datetime created_at\n    }\n\n    USERS ||--o{ CLUBS : manages\n    CLUBS ||--o{ EVENTS : organizes\n    USERS ||--o{ EVENTS : creates\n    USERS o|--o{ EVENTS : reviews\n\n    USERS ||--o{ REGISTRATIONS : registers\n    EVENTS ||--o{ REGISTRATIONS : receives\n    REGISTRATIONS ||--o| TICKETS : generates\n\n    CLUBS ||--o| BUDGETS : has\n    BUDGETS ||--o{ EXPENSES : records\n    USERS ||--o{ EXPENSES : enters\n\n    USERS ||--o{ FEEDBACK : writes\n    EVENTS ||--o{ FEEDBACK : receives\n\n    USERS ||--o{ SUBSCRIPTIONS : subscribes\n    CLUBS ||--o{ SUBSCRIPTIONS : gains\n\n    USERS ||--o{ NOTIFICATIONS : receives\n    EVENTS o|--o{ NOTIFICATIONS : concerns\n\n&quot;,&#10;  &quot;config&quot;: null,&#10;  &quot;version&quot;: &quot;12&quot;&#10;}" id="INjNVVMCv36Y6EAWg6hC-605">
